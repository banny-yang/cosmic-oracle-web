# 环境变量样例：复制为 .env.development / .env.production 按需修改
# 机密值放 *.local 文件（不入库），优先级高于同名模式文件

# 后端 API 地址（src/lib/api.ts）：
#   dev 默认 http://127.0.0.1:8080；生产为 https://oracle.duimai.net
#   运行时可用 window.__RUNTIME_CONFIG__.API_BASE_URL 覆盖（nginx 反代 HTML 注入）
VITE_API_BASE_URL=

# 统计开关："1" 启用 GoatCounter（__root.tsx，仅生产部署需要）
VITE_TRACKING=

# 站长平台验证码（__root.tsx 注入 meta，机密，放 .env.production.local）
# VITE_BAIDU_SITE_VERIFICATION=
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_BING_SITE_VERIFICATION=

# 头条搜索自动收录 token（__root.tsx 注入 ttzz push.js，公开值，放 .env.production.local）
# VITE_TOUTIAO_AUTO_PUSH=
