# 生产环境（vite build 自动加载；docker 构建前先 npm run build）
# 实测（2026-09）：API 由 server.oracle.duimai.net 直接提供（oracle.duimai.net/api 返回 404，DEPLOY.md 已过时）
# 部署容器可用环境变量覆盖：docker run -e API_BASE_URL=... （见 src/lib/runtime-env.ts）
VITE_API_BASE_URL=https://server.oracle.duimai.net

# 部署时启用 GoatCounter 统计（同域脚本，本地 dev 不加载）
VITE_TRACKING=1

# 站长平台验证码（机密，勿入库）：写入 .env.production.local（已被 .gitignore 的 *.local 忽略）
# VITE_BAIDU_SITE_VERIFICATION=
# VITE_GOOGLE_SITE_VERIFICATION=
# VITE_BING_SITE_VERIFICATION=
